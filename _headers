/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://api.web3forms.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://analytics.google.com; frame-src https://calendly.com https://buy.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com

/images/*
  Cache-Control: public, max-age=2592000

/*.pdf
  Cache-Control: public, max-age=2592000

/style.css
  Cache-Control: public, max-age=86400
